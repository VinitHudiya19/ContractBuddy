# =============================================================================
#  AI Document Q&A System — Environment Configuration
#  Copy this file to `.env` and fill in values. `.env` is gitignored.
#  Only the REQUIRED block is needed to boot; provider keys are optional
#  depending on which LLM_PROVIDER / EMBEDDING_PROVIDER you select.
# =============================================================================

# ---------------------------------------------------------------------------
# REQUIRED — core infrastructure
# ---------------------------------------------------------------------------
# For local docker-compose these hostnames resolve to the compose services.
DATABASE_URL=postgresql+asyncpg://raguser:ragpass@postgres:5432/ragdb
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333

# Auth — CHANGE THIS in any real deployment (use `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-secret-string-please
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — comma-separated list of allowed frontend origins (never use * in prod)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Uploads
MAX_UPLOAD_SIZE_MB=20

# ---------------------------------------------------------------------------
# PROVIDERS — pluggable. Defaults = zero-cost local embeddings + Groq LLM.
#   EMBEDDING_PROVIDER: local | openai | gemini
#   LLM_PROVIDER:       groq | gemini | openai | anthropic | ollama
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=local
LLM_PROVIDER=groq
# Optional automatic failover if the primary LLM provider trips its breaker:
LLM_FALLBACK_PROVIDER=

# Local embedding model (sentence-transformers) — no API key required.
LOCAL_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Local cross-encoder reranker — no API key required.
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ---- Provider API keys (only fill in the one(s) you actually use) ----
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Ollama (fully local LLM/embeddings) — only if LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ---------------------------------------------------------------------------
# Retrieval tuning
# ---------------------------------------------------------------------------
CHUNK_TOKENS=500
CHUNK_OVERLAP_TOKENS=50
VECTOR_TOP_K=15
KEYWORD_TOP_K=15
RERANK_TOP_K=5

# ---------------------------------------------------------------------------
# Rate limiting (sliding window, per user per endpoint)
# ---------------------------------------------------------------------------
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
# Bootstrap admin (created by scripts/seed.py). Change the password.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=admin12345
