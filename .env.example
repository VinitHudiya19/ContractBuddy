# =============================================================================
#  Contract Buddy — environment configuration
#
#  Copy to `.env` and edit. Every value below has a working default, so the app
#  boots with no `.env` at all: SQLite, the built-in vector store, no Redis, and
#  extractive (non-generated) answers.
#
#  docker-compose.yml overrides DATABASE_URL / REDIS_URL / QDRANT_URL with the
#  in-network service names, so the same file works for both setups.
# =============================================================================

# ---------------------------------------------------------------------------
# Infrastructure — all optional; each falls back cleanly when absent
# ---------------------------------------------------------------------------
# Local default. For Postgres:
#   postgresql+asyncpg://raguser:ragpass@localhost:5432/ragdb
DATABASE_URL=sqlite+aiosqlite:///./contractbuddy.db

# Used for rate limiting, JWT revocation and the document status mirror.
# If unreachable, rate limiting fails open and status is read from the database.
REDIS_URL=redis://localhost:6379/0

# auto   = use Qdrant when reachable, otherwise the built-in SQL vector store
# qdrant = require Qdrant (fail startup if it is down)
# sql    = always use the SQL store
VECTOR_STORE=auto
QDRANT_URL=http://localhost:6333

# ---------------------------------------------------------------------------
# Auth — CHANGE THE SECRET for anything reachable from a network
#   openssl rand -hex 32
# ---------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-secret-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated allowed origins. Never use "*" in production.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=20
UPLOAD_DIR=storage

# ---------------------------------------------------------------------------
# Providers
#   Leave GROQ_API_KEY empty and answers become extractive — quoted verbatim
#   from your documents and labelled as such, never invented.
#   Free key: https://console.groq.com
# ---------------------------------------------------------------------------

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Local models — no API key, downloaded once and cached (~275 MB total).
LOCAL_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ---------------------------------------------------------------------------
# Retrieval tuning
#   Each leg returns its TOP_K candidates; RRF fuses them; the reranker cuts
#   the list down to RERANK_TOP_K, which is what the model actually sees.
# ---------------------------------------------------------------------------
CHUNK_TOKENS=500
CHUNK_OVERLAP_TOKENS=50
VECTOR_TOP_K=15
KEYWORD_TOP_K=15
RERANK_TOP_K=5
# Set false to skip the cross-encoder (faster, less accurate).
RERANK_ENABLED=true

# ---------------------------------------------------------------------------
# Rate limiting — sliding window, per user per endpoint
# ---------------------------------------------------------------------------
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# Created automatically on first startup. Change the password.
