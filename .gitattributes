# Keep line endings sane so a Windows checkout still builds a working image.
* text=auto

# These run inside a Linux container. With CRLF the shebang becomes
# "/usr/bin/env bash\r" and the container fails with "bad interpreter".
# Only happens if you cloned on Windows, so pin it here.
*.sh            text eol=lf
Dockerfile      text eol=lf
*.Dockerfile    text eol=lf

# Binary assets git should not try to convert.
*.png  binary
*.jpg  binary
*.pdf  binary
*.ico  binary
